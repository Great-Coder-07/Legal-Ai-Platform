# Backend
GROQ_API_KEY=
DATABASE_URL=sqlite:///./legal_ai.db
# Leave unset to use %LOCALAPPDATA%\LegalAIPlatform\chroma_db.
# Do not place ChromaDB inside OneDrive/Dropbox/synced folders.
CHROMA_DB_PATH=
LEGACY_CHROMA_DB_PATH=./chroma_db

# Risk review context. Governing-law findings are relative to this value.
LEGAL_HOME_JURISDICTION=india

# Private clause-library controls
CLAUSE_LIBRARY_ENABLED=true
CHROMA_COLLECTION_NAME=legal_clauses_v2
CLAUSE_EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_LOCAL_FILES_ONLY=true
CLAUSE_SIMILARITY_THRESHOLD=0.45

# Privacy and resource controls
MAX_UPLOAD_MB=15
ENABLE_MODEL_PRELOAD=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (place in frontend/.env for Vite)
VITE_API_BASE_URL=http://localhost:8000
